[Unit]
Description=keycordon - keep secrets out of AI API requests
Documentation=https://gitlab.soraharu.com/XiaoXi/keycordon
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/xiaoxi/keycordon:latest
ContainerName=keycordon

# Loopback only. Change to 0.0.0.0:8318:8318 if clients on the network need
# it — they must then send an API key, or every anonymous caller shares one
# vault (see docs/quadlet.md).
PublishPort=127.0.0.1:8318:8318

# The master key lives here. Keep this volume, or every restart changes the
# placeholders and the upstream re-reads the whole prompt.
Volume=keycordon-data:/var/lib/keycordon

# The upstream as seen from the container. host.containers.internal is the
# host; a sibling container is reachable by its name on a shared network.
Exec=serve -config /etc/keycordon/config.yaml -upstream http://host.containers.internal:8317

# Pick up a new image on `podman auto-update`. Remove to upgrade by hand.
AutoUpdate=registry

LogDriver=journald

NoNewPrivileges=true
ReadOnly=true
Tmpfs=/tmp

[Service]
Restart=always
TimeoutStopSec=30

[Install]
WantedBy=default.target
